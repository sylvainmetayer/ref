<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="generator" content="Eleventy">
  {%- set pageTitle = metaTitle or site.name %}
  {%- if page.url == "/" %}
  {%- set pageDesc = "Mes codes et liens de parrainage pour " ~ (collections.referrals | titleList) ~ ", avec l'avantage offert et mon avis sur chaque service." %}
  {%- else %}
  {%- set pageDesc = metaDesc or site.description %}
  {%- endif %}
  <title>{{ pageTitle }}{% if page.url != "/" %} · {{ site.author.split(" ")[0] }}{% endif %}</title>
  <meta name="description" content="{{ pageDesc }}">
  {%- if page.url == "/404.html" %}
  <meta name="robots" content="noindex">
  {%- endif %}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- if site.googleSiteVerification %}
  <meta name="google-site-verification" content="{{ site.googleSiteVerification }}">
  {%- endif %}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/og.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  {%- if page.url == "/" %}
  {%- set items = [] %}
  {%- for item in collections.referrals %}
  {%- set items = (items.push({ "@type": "ListItem", "position": loop.index, "url": site.url ~ item.url, "name": "Parrainage " ~ item.data.title }), items) %}
  {%- endfor %}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "WebSite", "name": site.name, "url": site.url ~ "/", "inLanguage": "fr-FR", "author": { "@type": "Person", "name": site.author, "url": site.authorUrl } },
      { "@type": "ItemList", "name": "Codes et liens de parrainage", "itemListElement": items }
    ]
  } | json | safe }}</script>
  {%- elif slug %}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": site.brand, "item": site.url ~ "/" },
      { "@type": "ListItem", "position": 2, "name": "Parrainage " ~ title, "item": site.url ~ page.url }
    ]
  } | json | safe }}</script>
  {%- endif %}
  <link rel="preload" href="/assets/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/style.css">
  <script src="/assets/main.js" defer></script>
  {%- if site.cfBeaconToken %}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cfBeaconToken }}"}'></script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#contenu">Aller au contenu</a>
  <div class="container{% if narrow %} container--narrow{% endif %}">
    <header class="site-header">
      <a href="/" class="brand"><span class="brand__mark" aria-hidden="true">%</span><span class="brand__text">{{ site.brand }}</span></a>
      <nav class="site-nav" aria-label="Menu">
        <button type="button" class="nav-link search-open" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K" hidden>Rechercher <kbd>Ctrl K</kbd></button>
        <a href="{{ site.authorUrl }}" class="nav-link">À propos{% include "icons/external.njk" %}</a>
      </nav>
    </header>

    {{ content | safe }}

    <footer class="site-footer">
      <span>Fait maison, mis à jour depuis git le <time datetime="{{ build.date | isoDate }}">{{ build.date | shortDate }}</time>.</span>
      <span><a href="/mentions/">Mentions légales et confidentialité</a> · <a href="/plan-du-site/">Plan du site</a></span>
      <span><a href="{{ site.repo }}" hreflang="en">Voir les sources (GitHub, en anglais){% include "icons/external.njk" %}</a> · <a href="{{ site.repo }}/issues/new" hreflang="en">Un code ne marche plus ? (GitHub, en anglais){% include "icons/external.njk" %}</a></span>
    </footer>
  </div>

  <dialog class="search" aria-labelledby="search-title">
    <div class="search__head">
      <h2 id="search-title">Aller à un service</h2>
      <button type="button" class="search__close">Fermer</button>
    </div>
    <label class="sr-only" for="search-input">Nom ou catégorie</label>
    <input id="search-input" class="search__input" type="search" autofocus placeholder="Nom ou catégorie" autocomplete="off">
    <p class="search__count" aria-live="polite"></p>
    <ul class="search__list">
      {%- for item in collections.referrals %}
      <li data-search="{{ item.data.title | lower }} {{ item.data.category | lower }}"><a href="{{ item.url }}">{{ item.data.title }}</a> <span>{{ item.data.category }}</span></li>
      {%- endfor %}
    </ul>
  </dialog>
</body>
</html>
